{
  "name": "marden",
  "version": "2.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.8",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.111.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "expo": "~57.0.9",
    "expo-clipboard": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.0",
    "expo-font": "~57.0.0",
    "expo-haptics": "~57.0.1",
    "expo-intent-launcher": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-sharing": "~57.0.8",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "lucide-react-native": "^1.24.0",
    "punycode": "^2.3.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-enriched-markdown": "^0.7.4",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "pod-install": "^1.1.0",
    "tsx": "^4.23.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:device": "expo run:ios --device",
    "ios:prepare": "expo prebuild --platform ios --clean --no-install",
    "ios:pods": "pod-install",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "desktop": "npm run export:web && electron desktop/main.cjs",
    "build:mac": "npm run export:web && electron-builder --projectDir desktop --config electron-builder.yml --mac dmg --arm64",
    "build:win": "npm run export:web && electron-builder --projectDir desktop --config electron-builder.yml --win nsis --x64 --arm64",
    "build:desktop": "npm run export:web && electron-builder --projectDir desktop --config electron-builder.yml --mac dmg --win nsis --arm64 --x64",
    "publish:desktop": "npm run build:desktop",
    "generate:assets": "node scripts/generate-icons.js",
    "test": "tsx --test tests/*.test.mjs",
    "test:sync": "tsx --test tests/syncMerge.test.mjs",
    "build:apk": "npx eas-cli@latest build --platform android --profile preview",
    "build:apk:local": "bash scripts/build-local-apk.sh",
    "build:android": "npx eas-cli@latest build --platform android --profile production",
    "register:ios": "npx eas-cli@latest device:create",
    "build:ios:dev": "npx eas-cli@latest build --platform ios --profile development",
    "build:ios:preview": "npx eas-cli@latest build --platform ios --profile preview",
    "build:ios": "npx eas-cli@latest build --platform ios --profile production",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor"
  },
  "private": true
}
