# Marden v2 — Cloud Sync Configuration
# Copy this file to .env and fill in your Supabase project values.
# These variables are safe to expose in the client bundle — Supabase
# enforces Row‑Level Security so the anon key only accesses data
# belonging to the authenticated user.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
